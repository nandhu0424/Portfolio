# ==============================================================================
# Email Integration Configuration for Portfolio Contact Form
# Copy this file to `.env.local` and add your credentials.
# ==============================================================================

# Receiving Email (Defaults to nandhinin2004@gmail.com if omitted)
CONTACT_RECEIVER_EMAIL=nandhinin2004@gmail.com

# OPTION 1: EmailJS (Reliable free tier: 200 emails/month)
# Setup:
# 1. Sign up at https://www.emailjs.com/
# 2. Add Email Service connected to Gmail -> copy Service ID
# 3. Create Email Template (with {{from_name}}, {{from_email}}, {{reply_to}}, {{subject}}, {{message}}, {{submission_time}}) -> copy Template ID
# 4. Account Settings > Security / API Keys -> copy Public Key & Private Key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# OPTION 2: Resend (Fastest setup: 3,000 free emails/month)
# Setup:
# 1. Sign up at https://resend.com/
# 2. Create API key -> copy `re_...`
# 3. Uncomment and paste below:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

